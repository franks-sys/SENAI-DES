generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuarios {
  id             Int           @id @default(autoincrement())
  nome           String
  email          String        @unique
  senha          String
  data_cadastro  DateTime      @default(now())

  inscricoes     Inscricoes[]

  @@map("usuarios")
}

model Eventos {
  id             Int             @id @default(autoincrement())
  titulo         String
  descricao      String          @db.Text
  imagem         String?
  data_evento    DateTime
  local          String
  capacidade     Int
  status         StatusEvento    @default(ATIVO)
  criado_em      DateTime        @default(now())

  inscricoes     Inscricoes[]

  @@map("eventos")
}

model Inscricoes {
  id               Int                @id @default(autoincrement())
  data_inscricao   DateTime           @default(now())
  status           StatusInscricao    @default(CONFIRMADA)

  eventosId        Int
  usuariosId       Int

  eventos          Eventos @relation(fields: [eventosId], references: [id], onDelete: Cascade)
  usuarios         Usuarios @relation(fields: [usuariosId], references: [id], onDelete: Cascade)

  @@unique([usuariosId, eventosId])

  @@map("inscricoes")
}

enum StatusInscricao {
  CONFIRMADA
  LISTA_ESPERA
  CHAMADA
  CANCELADA
}

enum StatusEvento {
  ATIVO
  CANCELADO
  ENCERRADO
}